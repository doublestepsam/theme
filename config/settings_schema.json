[
  {
    "name": "theme_info",
    "theme_name": "Peak Line",
    "theme_version": "1.0.0",
    "theme_author": "Custom Build",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Brand colors" },
      { "type": "color", "id": "color_navy", "label": "Navy (header/footer)", "default": "#0B1F3A" },
      { "type": "color", "id": "color_navy_dark", "label": "Navy dark (footer base)", "default": "#071527" },
      { "type": "color", "id": "color_red", "label": "Accent red (CTAs, sale tags)", "default": "#E4002B" },
      { "type": "color", "id": "color_red_dark", "label": "Accent red hover", "default": "#C10023" },
      { "type": "color", "id": "color_background", "label": "Page background", "default": "#FFFFFF" },
      { "type": "color", "id": "color_background_alt", "label": "Alternate section background", "default": "#F3F4F6" },
      { "type": "color", "id": "color_text", "label": "Body text", "default": "#16181D" },
      { "type": "color", "id": "color_border", "label": "Borders / dividers", "default": "#E2E4E9" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "archivo_black_n4" },
      { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "assistant_n4" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Max page width", "min": 1100, "max": 1600, "step": 20, "unit": "px", "default": 1400 },
      { "type": "range", "id": "grid_gap", "label": "Grid spacing", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      { "type": "range", "id": "button_radius", "label": "Corner radius", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 2 }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "header", "content": "Social accounts" },
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" }
    ]
  },
  {
    "name": "Split sizing",
    "settings": [
      { "type": "header", "content": "Split-size shoe orders" },
      { "type": "paragraph", "content": "Lets shoppers order two different sizes for the same pair (one per foot), at a price premium. Applies to products tagged 'shoes' or with a Product Type containing 'Shoe' that have a Size option AND the order-type option set up below (see theme docs comment in main-product.liquid for setup steps)." },
      { "type": "checkbox", "id": "enable_split_sizing", "label": "Enable split-size ordering", "default": true },
      { "type": "text", "id": "split_sizing_label", "label": "Toggle label", "default": "Need two different sizes?" },
      { "type": "textarea", "id": "split_sizing_note", "label": "Helper text", "default": "One shoe from each size — a premium applies since it uses two separate pairs." },
      { "type": "range", "id": "split_sizing_premium_percent", "label": "Premium percentage (for customer-facing copy only — the real charge always comes from your variant price)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 20 },
      { "type": "text", "id": "split_sizing_option_name", "label": "Variant option name that holds the premium", "info": "Must exactly match an option name on your products, e.g. 'Order Type'.", "default": "Order Type" },
      { "type": "text", "id": "split_sizing_premium_value", "label": "Exact option value for the premium variant", "info": "Must exactly match a value of the option above, e.g. 'Split Pair (+20%)'.", "default": "Split Pair (+20%)" },
      { "type": "text", "id": "split_sizing_fee_note", "label": "Additional note (optional)" }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          { "value": "drawer", "label": "Drawer" },
          { "value": "page", "label": "Page" }
        ],
        "default": "drawer"
      }
    ]
  }
]
