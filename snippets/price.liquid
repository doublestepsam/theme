{%- comment -%}
  Renders a price block for a product or variant.
  Accepts: product (or variant with .price/.compare_at_price)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product
  # A variant is one shoe when the product carries a Side option, so a card
  # has to quote two of them or it undercuts the real pair price.
  assign multiplier = 1
  if product.options contains 'Side'
    assign multiplier = 2
  endif
  assign compare_at = target.compare_at_price | times: multiplier
  assign price = target.price | times: multiplier
-%}
<div class="product-card__price">
  {%- if compare_at > price -%}
    <span class="price__sale">{{ price | money }}</span>
    <span class="price__compare">{{ compare_at | money }}</span>
  {%- else -%}
    <span>{{ price | money }}</span>
  {%- endif -%}
</div>
