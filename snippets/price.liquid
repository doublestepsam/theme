{%- comment -%}
  Renders a price block for a product or variant.
  Accepts: product (or variant with .price/.compare_at_price)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product
  assign compare_at = target.compare_at_price
  assign price = target.price
-%}
<div class="product-card__price">
  {%- if compare_at > price -%}
    <span class="price__sale">{{ price | money }}</span>
    <span class="price__compare">{{ compare_at | money }}</span>
  {%- else -%}
    <span>{{ price | money }}</span>
  {%- endif -%}
</div>
