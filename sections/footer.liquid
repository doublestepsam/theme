<footer class="site-footer">
  <div class="page-width site-footer__top">
    <div>
      <div class="site-footer__logo">{{ shop.name }}</div>
      <p style="max-width:280px; font-size:0.88rem; opacity:0.8;">
        {{ section.settings.about_text | default: 'Gear and apparel for every sport, every season, every level.' }}
      </p>
      {% render 'social-icons' %}
    </div>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <div class="site-footer__heading">{{ block.settings.heading }}</div>
        <ul class="site-footer__links">
          {%- for link in block.settings.menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  <div class="site-footer__bottom page-width">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <span>Powered by Shopify</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About text",
      "default": "Gear and apparel for every sport, every season, every level."
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "link_column", "settings": { "heading": "Shop" } },
      { "type": "link_column", "settings": { "heading": "Help" } },
      { "type": "link_column", "settings": { "heading": "Company" } }
    ]
  }
}
{% endschema %}
