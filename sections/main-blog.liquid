<div class="page-width section-padding">
  <h1 style="margin-bottom:28px;">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="product-card">
          <div class="product-card__media">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="600" height="{{ 600 | divided_by: article.image.aspect_ratio }}">
            {%- else -%}
              {{ 'article-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="product-card__vendor">{{ article.published_at | date: '%B %d, %Y' }}</div>
          <div class="product-card__title" style="font-size:1.05rem; font-weight:800;">{{ article.title }}</div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {%- if paginate.previous.is_link -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next.is_link -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
