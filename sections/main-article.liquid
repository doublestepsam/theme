<div class="page-width section-padding" style="max-width:760px;">
  <div class="eyebrow">{{ article.published_at | date: '%B %d, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</div>
  <h1>{{ article.title }}</h1>
  {%- if article.image -%}
    <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | escape }}" style="margin:24px 0;" width="1200" height="{{ 1200 | divided_by: article.image.aspect_ratio }}">
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
  <hr class="divider" style="margin:32px 0;">
  <a href="{{ blog.url }}" class="btn btn--outline btn--sm">&larr; Back to {{ blog.title }}</a>
</div>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
