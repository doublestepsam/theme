<div class="collection-banner">
  <div class="page-width">
    <h1>{{ collection.title }}</h1>
    <div class="collection-banner__count">{{ collection.products_count }} products</div>
  </div>
</div>

<div class="page-width section-padding">
  {%- if collection.description != blank -%}
    <div class="rte" style="max-width:720px; margin-bottom:28px;">{{ collection.description }}</div>
  {%- endif -%}

  {%- paginate collection.products by 24 -%}
  <div class="collection-toolbar">
    <span>{{ paginate.current_offset | plus: 1 }}&ndash;{{ paginate.current_offset | plus: paginate.page_size | at_most: collection.products_count }} of {{ collection.products_count }}</span>
    <div>
      <label class="visually-hidden" for="SortBy">Sort by</label>
      <select id="SortBy" name="sort_by" onchange="window.location.href='?sort_by='+this.value">
        <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Featured</option>
        <option value="best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>Best Selling</option>
        <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>Alphabetically, A-Z</option>
        <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price, Low to High</option>
        <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price, High to Low</option>
        <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
      </select>
    </div>
  </div>

    {%- if collection.products.size > 0 -%}
      <div class="grid grid--4">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        <h2>No products found</h2>
        <p>Try browsing another category.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--navy">View All Products</a>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <div class="pagination">
        {%- if paginate.previous.is_link -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="current">{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next.is_link -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection product grid",
  "settings": []
}
{% endschema %}
