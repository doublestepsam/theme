<div class="hero" style="min-height:70vh;">
  <div class="hero__scrim" style="background:rgba(7,21,39,0.85);"></div>
  <div class="hero__content page-width" style="max-width:520px; text-align:center; margin:0 auto;">
    <div class="wordmark" style="margin-bottom:12px;">{{ shop.name }}</div>
    <h1 class="hero__heading">Something New Is Coming</h1>
    <p class="hero__subheading" style="margin-left:auto; margin-right:auto;">We're gearing up. Enter our password below or sign up to be notified when we launch.</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p style="color:#fff; font-weight:700; margin-bottom:12px;">Wrong password, try again.</p>
      {%- endif -%}
      <div class="newsletter__form" style="margin:0 auto 20px;">
        <input type="password" name="password" placeholder="Enter password" required>
        <button type="submit">Enter</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Password page", "settings": [] }
{% endschema %}
