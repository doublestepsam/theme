<div class="page-width section-padding">
  <div class="section-header">
    <h1>My Account</h1>
    <a href="{{ routes.account_logout_url }}" class="btn btn--outline btn--sm">Log Out</a>
  </div>
  <h2 style="margin-bottom:16px;">Order History</h2>
  {%- if customer.orders.size > 0 -%}
    <div style="border:2px solid var(--color-border);">
      {%- for order in customer.orders -%}
        <div style="display:flex; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--color-border);">
          <a href="{{ order.customer_url }}" style="font-weight:700;">{{ order.name }}</a>
          <span>{{ order.created_at | date: '%B %d, %Y' }}</span>
          <span>{{ order.financial_status_label }}</span>
          <span style="font-weight:800;">{{ order.total_price | money }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p>You haven't placed any orders yet.</p>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
