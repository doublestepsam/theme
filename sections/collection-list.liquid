<div class="section-padding{% if section.settings.background == 'alt' %} bg-alt{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="grid grid--{{ section.blocks.size | at_most: 5 }}">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <a href="{{ collection.url | default: '#' }}" class="category-tile" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="500" height="500">
          {%- elsif collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="500" height="500">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="category-tile__label">{{ block.settings.title | default: collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category tiles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Shop By" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Category" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "White" },
        { "value": "alt", "label": "Light gray" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Category tiles",
      "category": "Collection",
      "blocks": [
        { "type": "tile", "settings": { "title": "Footwear" } },
        { "type": "tile", "settings": { "title": "Apparel" } },
        { "type": "tile", "settings": { "title": "Fitness" } },
        { "type": "tile", "settings": { "title": "Outdoor" } },
        { "type": "tile", "settings": { "title": "Team Sports" } }
      ]
    }
  ]
}
{% endschema %}
