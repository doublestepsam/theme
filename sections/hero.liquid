{%- comment -%}
  Full-bleed homepage hero. Reuses the shared .hero* styles and adds the
  --tall modifier for the bottom-anchored, taller treatment.
{%- endcomment -%}
<div class="hero hero--tall">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {%- assign image = section.settings.image -%}
      <img
        src="{{ image | image_url: width: 1600 }}"
        alt="{{ image.alt | escape }}"
        width="1600"
        height="{{ 1600 | divided_by: image.aspect_ratio }}"
        fetchpriority="high"
      >
    {%- else -%}
      <img
        src="{{ 'hero-gradient.png' | asset_url }}"
        alt="Runner's legs in motion on a track"
        width="1600"
        height="1000"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>
  <div class="hero__scrim"></div>
  <div class="hero__fade" aria-hidden="true"></div>

  <div class="hero__content">
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="hero__subheading">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 }}" class="btn btn--outline-white">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shoes made for your feet." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Because your feet are different. Why shouldn't your shoes be?</p><p>DoubleStep lets you choose the size of each shoe individually, so you can build a pair that's made for you — not the average runner.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Men's" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button label", "default": "Shop Women's" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
