<div class="page-width section-padding">
  <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:520px; margin-bottom:32px; display:flex; border:2px solid var(--color-navy);">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}" style="flex:1; border:none; padding:14px 16px;">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="btn btn--navy" style="border-radius:0;">{{ 'general.search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <h2 style="margin-bottom:24px;">{{ 'general.search.results_for' | t: terms: search.terms }}</h2>
      <div class="grid grid--4">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'product-card', product: item -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        <h2>{{ 'general.search.no_results' | t: terms: search.terms }}</h2>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
