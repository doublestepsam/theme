<div class="section-padding{% if section.settings.background == 'navy' %} bg-navy{% elsif section.settings.background == 'alt' %} bg-alt{% endif %}">
  <div class="page-width promo-banner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="eyebrow"{% if section.settings.background == 'navy' %} style="color:#fff;"{% endif %}>{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn {% if section.settings.background == 'navy' %}btn--primary{% else %}btn--navy{% endif %}" style="margin-top:12px;">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Team Sports Headquarters" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Outfit your whole roster with jerseys, equipment, and fan gear.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Team Sports" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "White" },
        { "value": "alt", "label": "Light gray" },
        { "value": "navy", "label": "Navy" }
      ],
      "default": "alt"
    }
  ],
  "presets": [
    {
      "name": "Promo text",
      "category": "Text"
    }
  ]
}
{% endschema %}
