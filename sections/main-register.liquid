<div class="page-width section-padding" style="max-width:420px;">
  <h1 style="margin-bottom:24px;">Create Account</h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <p style="color:var(--color-red); font-weight:700; margin-bottom:16px;">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <div style="margin-bottom:16px;">
      <label class="variant-picker__label" for="FirstName">First name</label>
      <input type="text" id="FirstName" name="customer[first_name]" style="width:100%; padding:12px; border:2px solid var(--color-border);">
    </div>
    <div style="margin-bottom:16px;">
      <label class="variant-picker__label" for="LastName">Last name</label>
      <input type="text" id="LastName" name="customer[last_name]" style="width:100%; padding:12px; border:2px solid var(--color-border);">
    </div>
    <div style="margin-bottom:16px;">
      <label class="variant-picker__label" for="Email">Email</label>
      <input type="email" id="Email" name="customer[email]" required style="width:100%; padding:12px; border:2px solid var(--color-border);">
    </div>
    <div style="margin-bottom:16px;">
      <label class="variant-picker__label" for="Password">Password</label>
      <input type="password" id="Password" name="customer[password]" required style="width:100%; padding:12px; border:2px solid var(--color-border);">
    </div>
    <button type="submit" class="btn btn--primary btn--full">Create Account</button>
    <p style="margin-top:16px; font-size:0.85rem;">Already have an account? <a href="{{ routes.account_login_url }}" style="text-decoration:underline; font-weight:700;">Sign in</a></p>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
