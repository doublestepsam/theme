{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  # Men's and women's are separate products sharing a model, so the gender
  # belongs in the navigation line rather than repeated in the heading.
  assign gender_label = ''
  assign gender_tag = ''
  if product.handle contains '-womens'
    assign gender_label = "Women's"
    assign gender_tag = 'womens'
  elsif product.handle contains '-mens'
    assign gender_label = "Men's"
    assign gender_tag = 'mens'
  endif
  assign display_title = product.title | remove: " - Men's" | remove: " - Women's"

  # The same model in the other gender is a separate product, so offer it —
  # otherwise a shopper who lands on the wrong one has to start over.
  assign sibling_handle = ''
  assign sibling_label = ''
  if gender_tag == 'mens'
    assign sibling_handle = product.handle | replace: '-mens', '-womens'
    assign sibling_label = "Women's"
  elsif gender_tag == 'womens'
    assign sibling_handle = product.handle | replace: '-womens', '-mens'
    assign sibling_label = "Men's"
  endif
  assign sibling = all_products[sibling_handle]

  assign has_size_option = false
  assign side_position = 0
  # Each variant is one shoe, so a pair costs two of them. Until single-shoe
  # ordering exists, the page quotes the pair.
  assign price_multiplier = 1
  for option in product.options_with_values
    assign option_down = option.name | downcase
    if option_down contains 'size'
      assign has_size_option = true
    endif
    if option_down == 'side'
      assign side_position = option.position
      assign price_multiplier = 2
    endif
  endfor
  assign display_price = current_variant.price | times: price_multiplier
  assign display_compare_price = current_variant.compare_at_price | times: price_multiplier
-%}
<div class="section-padding page-width">
  <div class="product-main">

    <div class="product-gallery" data-gallery>
      <div class="product-gallery__main" data-gallery-main>
        {%- if current_variant.featured_image -%}
          <img src="{{ current_variant.featured_image | image_url: width: 1000 }}" alt="{{ current_variant.featured_image.alt | escape }}" width="1000" height="{{ 1000 | divided_by: current_variant.featured_image.aspect_ratio }}">
        {%- elsif product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | escape }}" width="1000" height="{{ 1000 | divided_by: product.featured_image.aspect_ratio }}">
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for media in product.media -%}
            <img
              data-gallery-thumb
              data-full-src="{{ media.preview_image | image_url: width: 1000 }}"
              src="{{ media.preview_image | image_url: width: 150 }}"
              alt="{{ media.preview_image.alt | escape }}"
              class="{% if forloop.first %}is-active{% endif %}"
              loading="lazy"
            >
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info" data-product-info>
      {%- if product.vendor != blank or gender_label != blank -%}
        <div class="product-info__vendor">
          {%- if gender_label != blank -%}
            <a href="{{ routes.collections_url }}/{{ gender_tag }}">{{ gender_label }}</a>
            {%- if product.vendor != blank %} / {% endif -%}
          {%- endif -%}
          {{- product.vendor -}}
          {%- if sibling.title != blank -%}
            <a class="product-info__switch" href="{{ sibling.url }}">Also in {{ sibling_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      <h1>{{ display_title }}</h1>

      <div class="product-info__price" data-price-wrapper>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="price__sale" data-price>{{ display_price | money }}</span>
          <span class="price__compare" data-compare-price>{{ display_compare_price | money }}</span>
          <span class="badge badge--sale" data-sale-badge>Sale</span>
        {%- else -%}
          <span data-price>{{ display_price | money }}</span>
          <span class="price__compare" data-compare-price hidden></span>
          <span class="badge badge--sale" data-sale-badge hidden>Sale</span>
        {%- endif -%}
      </div>

      <script type="application/json" data-product-variants>
        {{ product.variants | json }}
      </script>

      {%- form 'product', product, data-product-form: true -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

        {%- for option in product.options_with_values -%}
          {%- assign option_down = option.name | downcase -%}
          {%- if option_down == 'side' -%}
            {%- continue -%}
          {%- endif -%}
          {%- if option_down contains 'size' -%}
            <div class="split-size-fields" data-split-fields data-option-position="{{ option.position }}" data-side-position="{{ side_position }}">
              <div class="variant-picker" data-split-left>
                <span class="variant-picker__label">Left shoe size</span>
                <div class="variant-swatches">
                  {%- for value in option.values -%}
                    <button type="button" class="variant-swatch" data-variant-value data-value="{{ value | escape }}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
              <div class="variant-picker" data-split-right>
                <span class="variant-picker__label">Right shoe size</span>
                <div class="variant-swatches">
                  {%- for value in option.values -%}
                    <button type="button" class="variant-swatch" data-variant-value data-value="{{ value | escape }}">{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
              <p class="split-size-availability" data-split-availability></p>
            </div>
          {%- else -%}
            <div class="variant-picker" data-variant-picker data-option-position="{{ option.position }}" data-option-name="{{ option.name | escape }}">
              <span class="variant-picker__label">{{ option.name }}</span>
              <div class="variant-swatches">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="variant-swatch{% if value == option.selected_value %} is-selected{% endif %}"
                    data-variant-value
                    data-value="{{ value | escape }}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        <div class="product-form__buttons">
          <div class="qty-selector" data-qty-stepper>
            <button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>
            <input type="text" name="quantity" value="1" aria-label="Quantity" inputmode="numeric">
            <button type="button" data-qty-plus aria-label="Increase quantity">&plus;</button>
          </div>
          <button type="submit" class="btn btn--primary" data-add-to-cart-btn {% if has_size_option or current_variant.available == false %}disabled{% endif %}>
            <span data-add-to-cart-text>{%- if has_size_option -%}Select both sizes{%- elsif current_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}</span>
          </button>
        </div>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="product-info__accordion">
          <details class="accordion-item" open>
            <summary>Description</summary>
            <div class="accordion-item__content rte">{{ product.description }}</div>
          </details>
          <details class="accordion-item">
            <summary>Shipping &amp; Returns</summary>
            <div class="accordion-item__content">Free shipping on orders over $200. Returns accepted within 30 days with proof of purchase.</div>
          </details>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product information",
  "settings": []
}
{% endschema %}
