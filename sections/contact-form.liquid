<div class="page-width section-padding contact-page" id="ContactForm">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- form 'contact', id: 'ContactFormBody' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-status form-status--success" tabindex="-1" autofocus>
        {{ section.settings.success_message | default: 'Thanks — we got your message and will reply by email.' }}
      </p>
    {%- elsif form.errors -%}
      <div class="form-status form-status--error">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="contact-page__row">
      <div class="field">
        <label for="ContactFirstName">First name</label>
        <input type="text" id="ContactFirstName" name="contact[First name]" autocomplete="given-name" required>
      </div>
      <div class="field">
        <label for="ContactLastName">Last name</label>
        <input type="text" id="ContactLastName" name="contact[Last name]" autocomplete="family-name" required>
      </div>
    </div>

    <div class="field">
      <label for="ContactEmail">Email</label>
      <input type="email" id="ContactEmail" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required value="{{ form.email }}">
    </div>

    <div class="field">
      <label for="ContactBody">Message</label>
      <textarea id="ContactBody" name="contact[body]" rows="8" required>{{ form.body }}</textarea>
    </div>

    <div class="contact-page__actions">
      <button type="submit" class="btn btn--primary">{{ section.settings.button_label | default: 'Send message' }}</button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thanks — we got your message and will reply by email." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
