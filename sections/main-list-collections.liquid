<div class="page-width section-padding">
  <h1 style="margin-bottom:28px;">Shop by Category</h1>
  <div class="grid grid--4">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="category-tile">
        {%- if collection.featured_image -%}
          <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title | escape }}" loading="lazy" width="500" height="500">
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag }}
        {%- endif -%}
        <span class="category-tile__label">{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "All collections",
  "settings": []
}
{% endschema %}
