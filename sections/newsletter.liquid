<div class="section-padding bg-navy">
  <div class="page-width newsletter">
    <div class="eyebrow" style="color:#fff;">Stay in the game</div>
    <h2>{{ section.settings.heading | default: 'Join the Team' }}</h2>
    <p style="opacity:0.85; max-width:480px; margin:0 auto;">{{ section.settings.subheading }}</p>

    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter__form">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ 'newsletter.email_placeholder' | t }}"
          required
          aria-label="Email address"
        >
        <button type="submit">{{ 'newsletter.submit' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p style="margin-top:14px; font-weight:700;">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Team"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sign up for exclusive deals, new arrivals, and gear guides."
    }
  ]
}
{% endschema %}
