<div class="page-width section-padding">
  <h1 style="margin-bottom:28px;">Your Cart</h1>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <p>Your cart is empty</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--navy">Start Shopping</a>
    </div>
  {%- else -%}
    <div class="product-main">
      <div>
        {%- for item in cart.items -%}
          <div class="cart-line" style="grid-template-columns:110px 1fr auto;">
            <a href="{{ item.url }}" class="cart-line__image">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.image.alt | escape }}" loading="lazy">
              {%- endif -%}
            </a>
            <div>
              <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
              {%- unless item.variant.title contains 'Default' -%}
                <div class="cart-line__variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              {%- if item.properties.size > 0 -%}
                {%- for property in item.properties -%}
                  {%- if property.last != blank -%}
                    <div class="cart-line__property"><strong>{{ property.first }}:</strong> {{ property.last }}</div>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              <div class="cart-line__qty" data-qty-stepper data-line-key="{{ item.key }}">
                <button type="button" data-qty-minus aria-label="Decrease quantity">&minus;</button>
                <input type="text" value="{{ item.quantity }}" aria-label="Quantity" inputmode="numeric">
                <button type="button" data-qty-plus aria-label="Increase quantity">&plus;</button>
              </div>
              <div class="cart-line__remove" data-line-remove data-line-key="{{ item.key }}" role="button" tabindex="0">Remove</div>
            </div>
            <div style="font-weight:800;">{{ item.final_line_price | money }}</div>
          </div>
        {%- endfor -%}
      </div>

      <div>
        <div class="cart-subtotal-row">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-note">Shipping, taxes, and discounts calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--primary btn--full">Checkout</button>
        </form>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart page",
  "settings": []
}
{% endschema %}
