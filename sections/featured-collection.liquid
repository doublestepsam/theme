{%- liquid
  assign collection = collections[section.settings.collection]
  assign products_to_show = section.settings.products_to_show
-%}
<div class="section-padding{% if section.settings.background == 'alt' %} bg-alt{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}" class="btn btn--outline btn--sm">Shop All</a>
      {%- endif -%}
    </div>

    <div class="grid grid--4">
      {%- if collection != blank -%}
        {%- comment -%}
          Men's and women's are separate products sharing a model, so show one
          card per model. Relies on the -mens/-womens handle suffix.
        {%- endcomment -%}
        {%- assign shown = 0 -%}
        {%- assign seen_models = '' -%}
        {%- for product in collection.products -%}
          {%- if shown >= products_to_show -%}
            {%- break -%}
          {%- endif -%}
          {%- assign model = product.handle | remove: '-mens' | remove: '-womens' -%}
          {%- assign marker = '|' | append: model | append: '|' -%}
          {%- unless seen_models contains marker -%}
            {%- assign seen_models = seen_models | append: marker -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- render 'product-card', product: product -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <div class="product-card">
            <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="product-card__title">Select a collection</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Trending" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 8 },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "White" },
        { "value": "alt", "label": "Light gray" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "category": "Collection"
    }
  ]
}
{% endschema %}
