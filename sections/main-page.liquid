{%- liquid
  assign show_title = section.settings.show_title
-%}
{%- if show_title or page.content != blank -%}
  <div class="page-width section-padding">
    {%- if show_title -%}
      <h1>{{ page.title }}</h1>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true }
  ]
}
{% endschema %}
