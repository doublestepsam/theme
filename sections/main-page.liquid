{%- liquid
  assign show_title = section.settings.show_title
-%}
{%- if show_title or page.content != blank -%}
  <div class="page-width section-padding page-main">
    {%- if show_title -%}
      <h1 class="page-main__title{% if section.settings.title_size == 'small' %} page-main__title--small{% endif %}">{{ page.title }}</h1>
    {%- endif -%}
    {%- if page.content != blank -%}
      <div class="rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        { "value": "large", "label": "Large" },
        { "value": "small", "label": "Small" }
      ],
      "default": "large"
    }
  ]
}
{% endschema %}
